    "import chromadb\n",
    "\n",
    "db = chromadb.PersistentClient(path=\"./restaurant_vector_db\")           # saved in the folder \"restaurant_vector_db\": not lost\n",
    "store = db.get_or_create_collection(\n",
    "    name=\"restaurant_data\",\n",
    "    metadata={\n",
    "        \"hnsw:space\": \"cosine\"\n",
    "    }\n",
    ")\n",
    "\n",
    "if store.count() == 0:                                      # embed only the first time (saves free requests)\n",
    "    ids = []\n",
    "    documents = []\n",
    "    metadatas = []\n",
    "    for c in chunks:\n",
    "        ids.append(c[\"id\"])\n",
    "        documents.append(c[\"text\"])\n",
    "        metadatas.append({      # keep the file name with each chunk\n",
    "            \"source\": c[\"source\"]\n",
    "        })\n",
    "\n",
    "    store.add(\n",
    "        ids=ids,\n",
    "        documents=documents,\n",
    "        metadatas=metadatas,\n",
    "        embeddings=embed(documents),\n",
    "    )\n",
    "print(store.count(), \"chunks in the database\")"
   ]
  },
