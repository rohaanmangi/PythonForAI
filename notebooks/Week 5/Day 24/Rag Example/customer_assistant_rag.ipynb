    "def embed(texts):\n",
    "    r = client.embeddings.create(model=EMB_MODEL, input=texts)    # one request for the whole list\n",
    "    vectors = []\n",
    "    for item in r.data:\n",
    "        vectors.append(item.embedding)                            # one vector per text\n",
    "    return vectors"
   ]
  },
