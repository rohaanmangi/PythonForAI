    "def retrieve(question, n=3):\n",
    "    r = store.query(query_embeddings=embed([question]), n_results=n)\n",
    "    texts = r[\"documents\"][0]          # [0] = results for our first (only) question\n",
    "    sources = r[\"metadatas\"][0]\n",
    "    distances = r[\"distances\"][0]\n",
    "\n",
    "    found = []\n",
    "    for i in range(len(texts)):\n",
    "        found.append({\n",
    "            \"text\": texts[i],\n",
    "            \"source\": sources[i][\"source\"],\n",
    "            \"distance\": distances[i]\n",
    "        })\n",
    "    return found\n",
    "\n",
    "for f in retrieve(\"What food items are available?\"):\n",
    "    print(f\"{f['distance']:.2f}  [{f['source']}]  {f['text'][:70]}\")"
   ]
  },
