    "MODEL = \"nvidia/nemotron-3.5-lightning:free\"       # chat model (free)\n",
    "load_dotenv()                                       # finds .env and loads OPEN_ROUTER_KEY\n",
    "key = os.getenv(\"OPEN_ROUTER_KEY\") or getpass(\"Paste your OpenRouter key (hidden): \")\n",
    "client = OpenAI(base_url=\"https://openrouter.ai/api/v1\", api_key=key)\n",
