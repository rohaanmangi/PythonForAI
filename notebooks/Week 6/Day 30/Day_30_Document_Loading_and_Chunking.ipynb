    "def chunk_by_size(text, size=100, overlap=0):\n",
    "    chunks = []\n",
    "    step = size - overlap                       # how far we move for the next chunk\n",
    "    for start in range(0, len(text), step):\n",
    "        chunks.append(text[start:start + size])\n",
    "    return chunks\n",
    "\n",
    "\n",
    "\n",
    "leave = Path(\"company_docs/leave_policy.txt\").read_text(encoding=\"utf-8\")\n",
    "\n",
    "for chunk in chunk_by_size(leave, size=100)[:4]:\n",
    "    print(repr(chunk))"
   ]
