    "from pathlib import Path\n",
    "import re\n",
    "\n",
    "def load_documents(folder):\n",
    "    docs = []\n",
    "    for path in sorted(Path(folder).glob(\"*.txt\")):              # every .txt file in the folder\n",
    "        docs.append({\"source\": path.name, \"text\": path.read_text(encoding=\"utf-8\")})\n",
    "    return docs\n",
    "\n",
    "def chunk_by_size(text, size=100, overlap=0):                     # way 1 and 2\n",
    "    step = size - overlap\n",
    "    return [text[start:start + size] for start in range(0, len(text), step)]\n",
    "\n",
    "def chunk_by_sentence(text):                                      # way 3\n",
    "    return [s for s in re.split(r\"(?<=[.!?])\\s+|\\n\\n\", text.strip()) if s]\n",
    "\n",
    "def chunk_by_paragraph(text):                                     # way 4\n",
    "    parts = [p.strip() for p in text.split(\"\\n\\n\")]              # a blank line = a new paragraph\n",
    "    return [p for p in parts if len(p) > 30]                      # skip very short parts, like titles\n",
    "\n",
    "def chunk_recursive(text, max_size=120, seps=(r\"\\n\\n\", r\"(?<=[.!?])\\s+\")):     # way 5\n",
    "    text = text.strip()\n",
    "    if len(text) <= max_size or not seps:\n",
    "        return [text]\n",
    "    chunks = []\n",
    "    for part in re.split(seps[0], text):\n",
    "        chunks += chunk_recursive(part, max_size, seps[1:])\n",
    "    return [c for c in chunks if c]\n",
    "\n",
    "def chunk_documents(docs):\n",
    "    chunks = []\n",
    "    for doc in docs:\n",
    "        for i, text in enumerate(chunk_by_paragraph(doc[\"text\"])):\n",
    "            chunks.append({\"id\": f\"{doc['source']}-{i}\", \"source\": doc[\"source\"], \"text\": text})\n",
    "    return chunks\n",
    "\n",
    "docs = load_documents(\"company_docs\")\n",
    "chunks = chunk_documents(docs)\n",
    "\n",
    "print(len(docs), \"documents →\", len(chunks), \"chunks\")\n",
    "for c in chunks[:3]:\n",
    "    print(c[\"id\"], \"|\", c[\"text\"][:60])"
   ]
